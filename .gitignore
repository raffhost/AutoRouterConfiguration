# PyInstaller build artifacts - fully regenerated by `pyinstaller ...`,
# never worth committing (bloats repo, produces meaningless binary diffs)


# Python cache
__pycache__/
*.pyc


# Build files
build/
dist/
*.spec
installer_output/
*.egg-info/


# Application files
*.exe
*.iss
*.toml


# Local, machine-specific firmware files (not meant to be public/shared)
# Uncomment and adjust if your firmware folder ever lives inside the repo:
# Router_Firmwares/

